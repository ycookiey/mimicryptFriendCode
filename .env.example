# Friend Code Configuration
# Master password for all friend codes
MASTER_PASSWORD=your_secure_master_password_here

# Friend codes (will be encrypted with the master password)
# Format: IDENTIFIER_FC=friend_code

# Example for Nintendo Switch friend code
NINTENDO_FC=1234567890123456

# Example for Discord friend code
DISCORD_FC=username#1234

# Example for numeric only code
GAME_FC=987654321

# Add more friend codes as needed
# STEAM_FC=76561198012345678
# EPIC_FC=YourEpicUsername